# Copy to .env. Generate credentials; never commit .env.
CLIPFAC_ADMIN_TOKEN=
CLIPFAC_AGENT_TOKENS=[]
# Optional: [{"token":"A_SEPARATE_LONG_RANDOM_SECRET","scopes":["read","process","edit"]}]
GEMINI_API_KEY=
# GEMINI_MODEL=your-model-id
# Optional custom Gemini endpoint (a Gemini-compatible API, not Google's).
# Origin only — the client appends the API version, so no /v1beta suffix.
# GOOGLE_GEMINI_BASE_URL=https://your-gemini-endpoint.example
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=
# LLM_MODEL=your-model-id
# Vision/layout stages still need Gemini.
UPLOAD_POST_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=
WHISPER_MODEL=small
JOB_RETENTION_SECONDS=604800
SOURCE_RETENTION_SECONDS=604800
OUTPUT_MAX_GB=25
UPLOADS_MAX_GB=15
# PUBLIC_API_URL=https://your-clipfac-host.example

# Optional separate VISION provider for the editorial director:
# CLIPFAC_VISION_BASE_URL=https://your-provider.example/v1
# CLIPFAC_VISION_MODEL=your-vision-model
# CLIPFAC_VISION_API_KEY=
# CLIPFAC_DIRECTOR_GEMINI_MODEL=your-gemini-model

# Provider settings saved in the UI are encrypted with a private key in /app/data.
# Back up the entire data volume, including clipfac-vault.key.
# Optional alternative: supply your own Fernet key instead of the local key file.
# CLIPFAC_VAULT_KEY=
CLIPFAC_REPAIR_LIMIT=2
